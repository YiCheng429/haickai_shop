# ===== 伺服器 =====
PORT=3000
# 對外路徑前綴；API 會掛在 ${BASE_PATH}/api，同時也掛在 /api（反向代理有沒有去掉前綴都能用）
BASE_PATH=/shop
NODE_ENV=production
# 位於 nginx 等反向代理後方時設 1（信任一層代理的 X-Forwarded-For，用來做 IP 限流）
TRUST_PROXY=1
# 允許跨網域呼叫的來源，逗號分隔；前後端同網域時留空即可
CORS_ORIGINS=
# 是否由 Node 一併提供前端靜態檔（docker-compose 單機部署用）；用 nginx 直接提供靜態檔時設 false
SERVE_STATIC=false
STATIC_DIR=..

# ===== 資料庫 =====
# docker-compose 會自動用 POSTGRES_PASSWORD 組出 DATABASE_URL；自行架設時才需要填
DATABASE_URL=postgres://glimmer:change-me@localhost:5432/glimmer
# docker-compose 使用的資料庫密碼
POSTGRES_PASSWORD=change-me
# 連線雲端資料庫需 SSL 時設 true
DATABASE_SSL=false

# ===== 管理後台 =====
# 至少 32 字元的隨機字串，例如：openssl rand -hex 32
ADMIN_TOKEN=

# ===== 限流 =====
# 每個 IP 每 15 分鐘最多建立幾筆訂單
ORDER_RATE_LIMIT=10
# 每個 IP 每 15 分鐘最多查詢幾次訂單
LOOKUP_RATE_LIMIT=30
# 每個 IP 每 15 分鐘最多回報幾次匯款
REPORT_RATE_LIMIT=10

# ===== 匯款資訊（顯示在下單成功畫面與通知信）=====
# 未填 BANK_ACCOUNT 時，會告知顧客「匯款資訊將以 Email 提供」；BANK_ACCOUNT_NAME 未填則不顯示戶名
BANK_NAME=國泰世華
BANK_CODE=013
BANK_ACCOUNT=127506292433
BANK_ACCOUNT_NAME=張奕誠
PAYMENT_DEADLINE_HOURS=48

# ===== Email 通知（選填；未設定 SMTP_HOST 則略過寄信）=====
SHOP_NAME=微光盲盒 Glimmer Box
OWNER_EMAIL=haickaiservice@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Gmail 請使用「應用程式密碼」，不是登入密碼
SMTP_PASS=
SMTP_FROM=
# 是否同時寄訂單確認信給顧客
SEND_CUSTOMER_EMAIL=false
